      "name": "Gmail — Mail Getir"
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\nlet body = '';\nif (msg.snippet) body = msg.snippet;\nif (msg.payload && msg.payload.parts) {\n    body += JSON.stringify(msg.payload.parts); \n}\n\nconst zoomMatch = body.match(/https:\\/\\/[\\w.-]*zoom\\.us\\/[^\\s<>\"]+/);\nconst meetMatch = body.match(/https:\\/\\/meet\\.google\\.com\\/[^\\s<>\"]+/);\nconst teamsMatch = body.match(/https:\\/\\/teams\\.microsoft\\.com\\/[^\\s<>\"]+/);\n\nconst dateMatch = body.match(/(\\d{4}-\\d{2}-\\d{2})|(\\d{1,2}[.\\/]\\d{1,2}[.\\/]\\d{2,4})/);\nconst timeMatch = body.match(/(\\d{1,2}:\\d{2}\\s*(AM|PM|am|pm)?)/);\n\nconst headers = (msg.payload && msg.payload.headers) ? msg.payload.headers : [];\nconst getH = (n) => { const x = headers.find(h => h.name.toLowerCase() === n.toLowerCase()); return x ? x.value : ''; };\n\nreturn [{\n  json: {\n    status: 'success',\n    mail_id: msg.id,\n    subject: getH('subject'),\n    from: getH('from'),\n    meeting_link: zoomMatch?.[0] || meetMatch?.[0] || teamsMatch?.[0] || null,\n    detected_date: dateMatch?.[0] || null,\n    detected_time: timeMatch?.[0] || null,\n    snippet: msg.snippet ? msg.snippet.substring(0, 300) : ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
