        680,
        -80
      ],
      "id": "0a20d021-a265-4113-97a4-8b79a1aba53d",
      "name": "Yanıt — Etkinlik Eklendi"
    },
    {
      "parameters": {
        "jsCode": "const token = $json.body.access_token;\nconst count = $json.body.count || 5;\n\nconst options = {\n  method: 'GET',\n  url: `https://gmail.googleapis.com/gmail/v1/users/me/messages?maxResults=${count}`,\n  headers: { 'Authorization': `Bearer ${token}` },\n  json: true\n};\n\nlet emails = [];\ntry {\n    const listRes = await this.helpers.httpRequest(options);\n    const messages = listRes.messages || [];\n\n    for (const m of messages) {\n        const detailOpt = {\n          method: 'GET',\n          url: `https://gmail.googleapis.com/gmail/v1/users/me/messages/${m.id}`,\n          headers: { 'Authorization': `Bearer ${token}` },\n          json: true\n        };\n        const msgData = await this.helpers.httpRequest(detailOpt);\n        const headers = msgData.payload.headers || [];\n        const getH = (n) => { const x = headers.find(h => h.name.toLowerCase() === n.toLowerCase()); return x ? x.value : ''; };\n        emails.push({\n            id: msgData.id,\n            subject: getH('subject'),\n            from: getH('from'),\n            date: getH('date'),\n            snippet: msgData.snippet\n        });\n    }\n} catch (error) {\n    return [{ json: { status: 'error', message: error.message } }];\n}\n\nreturn [{ json: Object.assign({}, $json, { emails: emails }) }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        80
